# Copy to .env and fill in. .env is gitignored — never commit it.

# --- Google OAuth (the only sign-in method) ---
# https://console.cloud.google.com/apis/credentials
# Create an "OAuth client ID" of type "Web application".
#   Authorized JavaScript origin : http://127.0.0.1:8000
#   Authorized redirect URI      : http://127.0.0.1:8000/accounts/google/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# The public domain. Only read when DEBUG is off, where it fills in
# ALLOWED_HOSTS, CSRF_TRUSTED_ORIGINS and the URLs in outgoing email. Set it on
# staging so staging cannot send anybody to production.
# SITE_DOMAIN=xtise.gr

# Production, with TLS terminating at a proxy in front of this app:
#
#   DJANGO_DEBUG=False
#   DJANGO_ALLOWED_HOSTS=xtise.gr,www.xtise.gr
#   SITE_URL=https://xtise.gr
#
# Turning DEBUG off is what switches on the secure cookies, the HTTPS redirect,
# HSTS and the rest — see the Production block in config/settings.py. Start HSTS
# short on the first deploy and raise it once you are sure:
#
#   DJANGO_HSTS_SECONDS=300
#
# And set the redirect off only if something in front of the app already does
# it: DJANGO_SSL_REDIRECT=False

# Set only while tunnelling the dev server to a real device (ngrok et al), to
# the public host with no scheme — e.g. abc123.ngrok-free.dev. Adds it to
# ALLOWED_HOSTS and CSRF_TRUSTED_ORIGINS and trusts the forwarded proto, so
# POSTs are not rejected and OAuth callbacks are built as https. The tunnel's
# callback URL also has to be registered with Google. Leave blank otherwise.
DJANGO_TUNNEL_HOST=

# --- Business rules (all optional; defaults live in config/business_rules.py) ---
# PLATFORM_FEE_PCT=0.12
# CLIENT_APPROVAL_WINDOW_HOURS=48
# EARLY_END_DISPUTE_WINDOW_HOURS=2
# MINIMUM_GUARANTEED_HOURS=2
# DEFAULT_REGION_NAME=Launch City
# DEFAULT_REGION_TIMEZONE=America/New_York
# ISO 3166-1 alpha-2, and it reaches Stripe: a worker's Connect account is
# opened in their region's country, which decides what onboarding asks for and
# whether payouts work at all. Set it before anybody onboards — moving a live
# Connect account to another country is not something you do from here.
# DEFAULT_REGION_COUNTRY=US

# --- Postgres (leave unset to use SQLite locally) ---
# POSTGRES_DB=
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Stripe (escrow for gig posts) ---
# Test-mode keys from https://dashboard.stripe.com/test/apikeys
# Connect must be enabled on the account: https://dashboard.stripe.com/test/connect
# Leave blank to run everything except payments.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to 127.0.0.1:8000/stripe/webhook/`
STRIPE_WEBHOOK_SECRET=

# How many days before a gig funding opens. Card holds expire after ~7 days,
# so this must stay comfortably under that. See config/business_rules.py.
# ESCROW_AUTHORIZATION_MAX_DAYS=5

# --- Assistant (the in-app chat helper) ---
# https://platform.openai.com/api-keys
# Leave blank to run everything else; the widget hides itself when unset.
OPENAI_API_KEY=
# A small model is the right tool here: the assistant asks short questions and
# returns structured field values, and usage per user is a handful of messages.
# OPENAI_MODEL=gpt-4o-mini
# Hard ceiling per reply. The assistant is meant to be terse; a long answer is
# a symptom, not a feature, and this stops one runaway turn costing real money.
# OPENAI_MAX_OUTPUT_TOKENS=600
# Requests per user per hour. Cheap insurance against a stuck client loop.
# ASSISTANT_RATE_LIMIT_PER_HOUR=60

# --- Email ---
# Unset, mail is printed to the console instead of sent. Set EMAIL_HOST to
# switch to real SMTP; nothing else here is read until you do.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=XTISE <no-reply@example.com>

# Where links in an email point. An email is read outside the browser session
# that caused it, so it cannot use a relative URL.
# SITE_URL=https://your-domain.example.com
